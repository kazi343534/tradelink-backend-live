# TradeLink Backend environment configuration
# Copy to `.env` and fill in real values.

PORT=8081

# PostgreSQL connection string (Supabase uses this format)
DATABASE_URL=postgresql://postgres.osnhftjsormgodsabdbn:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Secret used to verify JWT tokens issued by Supabase Auth (users.id)
# Set to `supabase_jwt_secret` found in Project Settings -> API.
JWT_SECRET=your-supabase-jwt-secret

# If NOT using Supabase Auth, set to "false" and send a `X-User-Id` header in dev.
AUTH_PROVIDER=supabase

# Optional: run in read-only/demo mode with no DB access (returns mock data)
DEMO_MODE=false

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:8080